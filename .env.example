# Copy to .env and replace every "change-me" value (e.g. `openssl rand -base64 24`).
# Docker Compose refuses to start while a required secret is missing.

POSTGRES_DB=siem
POSTGRES_USER=siem_app
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared by the demo realm users (admin, sam.analyst, sam.manager, sam.admin, sam.viewer); min 12 chars.
SIEM_DEMO_PASSWORD=change-me-min-12-chars
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OIDC_ISSUER_URI=http://localhost:18088/realms/enterprise-siem
OIDC_JWK_SET_URI=http://keycloak:8080/realms/enterprise-siem/protocol/openid-connect/certs

# Host ports. Everything binds to 127.0.0.1 and uses a dedicated range so it
# doesn't collide with a local Postgres (5432), Vite (5173), etc.
SIEM_FRONTEND_PORT=15173
SIEM_GATEWAY_PORT=18080
SIEM_KEYCLOAK_PORT=18088
SIEM_POSTGRES_PORT=15432
SIEM_REDIS_PORT=16379
SIEM_KAFKA_PORT=19092
SIEM_OPENSEARCH_PORT=19200
SIEM_PROMETHEUS_PORT=19090
SIEM_GRAFANA_PORT=13000
SIEM_KAFKA_UI_PORT=18090
