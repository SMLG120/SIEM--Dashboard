[
  {
    "id": "SIEM-1001",
    "version": 1,
    "name": "Critical Malware Detected",
    "description": "Endpoint protection reported a malware or ransomware detection.",
    "severity": "CRITICAL",
    "enabled": true,
    "type": "SINGLE",
    "condition": {
      "eventTypes": [
        "MALWARE_DETECTED",
        "RANSOMWARE_ACTIVITY",
        "RANSOMWARE"
      ],
      "severityMin": "HIGH"
    },
    "mitre": [
      {
        "tactic": "Execution",
        "techniqueId": "T1204",
        "technique": "User Execution"
      },
      {
        "tactic": "Impact",
        "techniqueId": "T1486",
        "technique": "Data Encrypted for Impact"
      }
    ],
    "falsePositives": [
      "EDR test detections (e.g. EICAR) run by the security team",
      "Quarantined files re-scanned after restore"
    ],
    "examples": {
      "match": [
        {
          "id": "ex-1",
          "timestamp": "2026-01-15T09:00:01Z",
          "eventType": "MALWARE_DETECTED",
          "severity": "HIGH",
          "sourceIp": "10.0.4.21",
          "sourceHost": "wks-042"
        }
      ],
      "noMatch": [
        {
          "id": "ex-2",
          "timestamp": "2026-01-15T09:00:02Z",
          "eventType": "MALWARE_DETECTED",
          "severity": "MEDIUM",
          "sourceIp": "10.0.4.21"
        }
      ]
    }
  },
  {
    "id": "SIEM-1002",
    "version": 1,
    "name": "Repeated Login Failures",
    "description": "High-severity authentication failures indicate a brute-force attempt.",
    "severity": "HIGH",
    "enabled": true,
    "type": "SINGLE",
    "condition": {
      "eventTypes": [
        "LOGIN_FAILURE"
      ],
      "severityMin": "HIGH"
    },
    "mitre": [
      {
        "tactic": "Credential Access",
        "techniqueId": "T1110",
        "technique": "Brute Force"
      }
    ],
    "falsePositives": [
      "Source systems that already aggregate failures and emit one HIGH event for a locked account",
      "See SIEM-1008 for the volume-based variant"
    ],
    "examples": {
      "match": [
        {
          "id": "ex-1",
          "timestamp": "2026-01-15T09:00:01Z",
          "eventType": "LOGIN_FAILURE",
          "severity": "HIGH",
          "sourceIp": "198.51.100.7",
          "userName": "alice"
        }
      ],
      "noMatch": [
        {
          "id": "ex-2",
          "timestamp": "2026-01-15T09:00:02Z",
          "eventType": "LOGIN_FAILURE",
          "severity": "LOW",
          "sourceIp": "198.51.100.7",
          "userName": "alice"
        }
      ]
    }
  },
  {
    "id": "SIEM-1003",
    "version": 1,
    "name": "Privilege Escalation Attempt",
    "description": "A privilege escalation or unauthorized elevation attempt was observed.",
    "severity": "CRITICAL",
    "enabled": true,
    "type": "SINGLE",
    "condition": {
      "eventTypes": [
        "PRIVILEGE_ESCALATION",
        "TOR_UNKNOWN"
      ],
      "severityMin": "HIGH"
    },
    "mitre": [
      {
        "tactic": "Privilege Escalation",
        "techniqueId": "T1068",
        "technique": "Exploitation for Privilege Escalation"
      },
      {
        "tactic": "Command and Control",
        "techniqueId": "T1090.003",
        "technique": "Proxy: Multi-hop Proxy"
      }
    ],
    "falsePositives": [
      "Approved admin elevation (sudo/runas) misreported as escalation by the source",
      "TOR_UNKNOWN is grouped here for backwards compatibility; it indicates anonymised access rather than elevation"
    ],
    "examples": {
      "match": [
        {
          "id": "ex-1",
          "timestamp": "2026-01-15T09:00:01Z",
          "eventType": "PRIVILEGE_ESCALATION",
          "severity": "HIGH",
          "userName": "svc-backup",
          "sourceHost": "srv-db-01"
        }
      ],
      "noMatch": [
        {
          "id": "ex-2",
          "timestamp": "2026-01-15T09:00:02Z",
          "eventType": "PRIVILEGE_ESCALATION",
          "severity": "MEDIUM",
          "userName": "svc-backup"
        }
      ]
    }
  },
