  {
    "id": "SIEM-1009",
    "version": 1,
    "name": "Successful Login After Repeated Failures",
    "description": "Three or more failed logins for an account followed by a successful login within ten minutes: a possible successful brute force.",
    "severity": "CRITICAL",
    "enabled": true,
    "type": "SEQUENCE",
    "suppressionSeconds": 1800,
    "condition": {},
    "sequence": {
      "groupBy": [
        "userName"
      ],
      "windowSeconds": 600,
      "steps": [
        {
          "name": "failures",
          "condition": {
            "eventTypes": [
              "LOGIN_FAILURE"
            ]
          },
          "minCount": 3
        },
        {
          "name": "success",
          "condition": {
            "eventTypes": [
              "LOGIN_SUCCESS"
            ]
          }
        }
      ]
    },
    "mitre": [
      {
        "tactic": "Credential Access",
        "techniqueId": "T1110",
        "technique": "Brute Force"
      },
      {
        "tactic": "Initial Access",
        "techniqueId": "T1078",
        "technique": "Valid Accounts"
      }
    ],
    "falsePositives": [
      "A user mistyping their password a few times before succeeding (tune minCount for your environment)"
    ],
    "examples": {
      "match": [
        {
