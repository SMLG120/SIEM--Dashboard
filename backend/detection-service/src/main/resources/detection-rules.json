  {
    "id": "SIEM-1010",
    "version": 1,
    "name": "Suspicious PowerShell Execution",
    "description": "PowerShell run with encoded commands, download cradles or in-memory execution.",
    "severity": "HIGH",
    "enabled": true,
    "type": "SINGLE",
    "condition": {
      "eventTypes": [
        "POWERSHELL",
        "PROCESS_CREATE"
      ],
      "messageContainsAny": [
        "-encodedcommand",
        "-enc ",
        "frombase64string",
        "iex(",
        "iex (",
        "invoke-expression",
        "downloadstring",
        "downloadfile",
        "-windowstyle hidden",
        "-w hidden",
        "-executionpolicy bypass",
        "-ep bypass"
      ]
    },
    "mitre": [
      {
        "tactic": "Execution",
        "techniqueId": "T1059.001",
        "technique": "Command and Scripting Interpreter: PowerShell"
      },
      {
        "tactic": "Defense Evasion",
        "techniqueId": "T1027",
        "technique": "Obfuscated Files or Information"
      }
    ],
    "falsePositives": [
      "Management tooling (SCCM, Intune, RMM agents) that legitimately uses -EncodedCommand",
      "Admin scripts launched with -ExecutionPolicy Bypass"
    ],
    "examples": {
      "match": [
        {
          "id": "ex-1",
          "timestamp": "2026-01-15T09:00:01Z",
          "eventType": "PROCESS_CREATE",
          "severity": "MEDIUM",
          "sourceHost": "wks-017",
          "userName": "dave",
          "message": "powershell.exe -nop -w hidden -EncodedCommand SQBFAFgAIAAoAE4AZQB3AC0ATwBiAGoAZQBjAHQA"
        }
      ],
      "noMatch": [
        {
          "id": "ex-2",
          "timestamp": "2026-01-15T09:00:02Z",
          "eventType": "PROCESS_CREATE",
          "severity": "MEDIUM",
          "sourceHost": "wks-017",
          "userName": "dave",
          "message": "powershell.exe -File C:\\Scripts\\inventory.ps1"
        }
      ]
    }
  },
